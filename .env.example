APP_NAME=GetMyServe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=getmyserve
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=pusher

# Pusher (free tier — sign up at pusher.com)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ZIWO Call Center
ZIWO_API_URL=https://api.ziwo.io
ZIWO_ACCOUNT_NAME=
ZIWO_USERNAME=
ZIWO_PASSWORD=
ZIWO_WEBHOOK_SECRET=
ZIWO_DEFAULT_CALLER_ID=
ZIWO_RECORDING_DISK=local
